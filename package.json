{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"description": "Pi Coding Agent extensions by Mist-wu.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi"
	],
	"homepage": "https://github.com/Mist-wu/pi-extensions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mist-wu/pi-extensions.git"
	},
	"bugs": {
		"url": "https://github.com/Mist-wu/pi-extensions/issues"
	},
	"workspaces": [
		"chrome-devtools",
		"websearch"
	],
	"pi": {
		"extensions": [
			"./chrome-devtools/src/index.ts",
			"./websearch/index.ts"
		]
	},
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"format": "npm run format --workspaces --if-present",
		"check": "npm run check --workspaces --if-present"
	}
}
