{
	"name": "@mist-wu/pi-chrome-devtools",
	"version": "0.1.0",
	"description": "Pi extension that exposes Chrome DevTools Protocol tools.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"chrome",
		"devtools",
		"cdp",
		"webmcp"
	],
	"homepage": "https://github.com/Mist-wu/pi-extensions/tree/main/chrome-devtools#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Mist-wu/pi-extensions.git",
		"directory": "chrome-devtools"
	},
	"bugs": {
		"url": "https://github.com/Mist-wu/pi-extensions/issues"
	},
	"files": [
		"src",
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run build && npm run lint && npm run typecheck && npm test",
		"prepack": "npm run build",
		"smoke:e2e": "node scripts/smoke-e2e.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-agent-core": "^0.85.0",
		"@earendil-works/pi-ai": "^0.85.0",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-server": "^0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@types/node": "26.4.1",
		"esbuild": "0.28.2",
		"jiti": "^2.7.0",
		"typebox": "1.3.25",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
